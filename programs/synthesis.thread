: observation-step
  36 s@ 0= if exit then
  3 s@ 3 mf w@ serial-of 44 s@ = 0= 3 s@ 10 mf w@ or if
    0 36 s! 27 s@ version-release drop 0 27 s! exit
  then
  observation-fault?
  ptick @ 37 s@ - 7 s@ >= 29 s@ 13 ef w@ 38 s@ = and
  29 s@ 13 ef w@ 29 s@ 20 ef w@ < and or if
    3 s@ module-rollback
    4 s@ 0 pf w@ 4 < if 4 s@ 0 ef w@ process-pause then
    4 s@ 0 ef w@ industry-repair
    observation-repair
    5 17 s! 0 36 s!
    ." NATIVE-ROLLBACK " 2 s@ . 3 s@ . ptick @ . cr
  then
  ptick @ 37 s@ - 7 s@ >= if 0 36 s! then
  36 s@ 0= if 27 s@ version-release drop 0 27 s! then
;
: autonomy-module
  \ (enabled module --); opt-in is native data, not a UI-only preference.
  wm ! wa ! 0 ws-error !
  wm @ valid-module wa @ 2 < and if
    wa @ 0= wm @ 10 mf w!
    ." AUTONOMY-MODULE " wm @ . wa @ . cr
  else 34 wfail report-error then
;
: goal-select
  \ Largest unfinished supplied factory goal; ascending slot breaks ties.
  16 47 s! 0 48 s! 2 51 s! 0 22 s!
  begin 22 s@ 16 < while
    22 s@ 1 ef w@ 4 = if
      22 s@ 13 ef w@ 22 s@ 20 ef w@ < if 3 51 s! then
    then
    22 s@ 1 ef w@ 2 = 22 s@ 0 pf w@ 4 < and if
      22 s@ 2 pf w@ 10 mf w@ 0= if
        22 s@ 10 ef w@ entity-find dup if
          1- 49 s!
          49 s@ 13 ef w@ 49 s@ 20 ef w@ < if
            22 s@ 3 ef w@ 22 s@ 4 ef w@ 2 * + 22 s@ 11 ef w@ 2 * + 23 s!
            22 s@ 9 ef w@ entity-find dup if
              1- 3 ef w@ 23 s+!
            else drop then
            49 s@ 20 ef w@ 49 s@ 13 ef w@ - 24 s!
            23 s@ 0 > 24 s@ 48 s@ > and if
              22 s@ 47 s! 24 s@ 48 s! 49 s@ 50 s!
            then
          then
        else drop then
      then
    then 1 22 s+!
  repeat
  47 s@ 16 < if 1 51 s! then
  ." GOAL " 51 s@ . 47 s@ . 50 s@ . 48 s@ . ptick @ . cr
;
: autonomy-enabled
  dup 2 < if 0 s! else drop ." SEARCH-REFUSED 2" cr then
;
: autonomy-step
  ." WORLD 0 " 2 s@ . cr process-step observation-step search-step
  0 s@ 1 s@ 0= and 36 s@ 0= and if
    goal-select
    51 s@ 1 = ptick @ 52 s@ >= and 53 s@ 54 s@ < and if
      1 53 s+! 47 s@ 1 32 search-start
    then
    51 s@ 2 = if ." SCENARIO-COMPLETE " ptick @ . cr then
  then
;
: synthesis-state
  ." SYNTHESIS " 0 22 s! begin 22 s@ 40 < while 22 s@ s@ . 1 22 s+! repeat cr
;

