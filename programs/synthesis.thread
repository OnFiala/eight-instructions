\ Build 004 native synthesis. The supervisor owns store0..2559.
\ No actor word exposes this store, generic context copies or raw memory.
\ Four heap/workspace value contexts:0 execution,1 checkpoint,2 parked live,
\ 3 trial. Resident definitions stay immutable while a search is running.
\ Supervisor fields:0enabled,1phase,2generation,3module,4factory,5ordinal,
\ 6budget,7horizon,8trial-rounds,9target-start,10checkpoint-round,11version,
\ 12input-epoch,13checkpoint-epoch,14baseline,15best,16best-ordinal,17decision,
\ 18evaluated,19published,20rejected,21source-length,22iterator,23temp,
\ 24fragment-length,25fragment-base,26invalid,27pin,28revision,29target,
\ 30score,31fault,32installed,33pending,34cargo,35trial-target,36protected,
\ 37observation-start,38observation-installed,39retained-length.
: s@ p@ ;
: s! p! ;
: s+! dup p@ rot + swap p! ;
: fragment
  \ (length id --) followed by exact raw grammar bytes. Not whole solutions.
  2 * 128 + 23 s! dup 24 s! 23 s@ 1+ p!
  127 p@ 23 s@ p! 0 22 s!
  begin 22 s@ 24 s@ < while
    key 127 p@ 22 s@ + p! 1 22 s+!
  repeat 127 p@ 24 s@ + 127 p!
;
160 127 p!
\ Grammar fragments are initialized below as raw input data.
: source-byte,
  21 s@ 512 < if 512 21 s@ + p! 1 21 s+! else drop 1 26 s! then
;
: fragment,
  2 * 128 + dup p@ 25 s! 1+ p@ 24 s! 0 22 s!
  begin 22 s@ 24 s@ < while
    25 s@ 22 s@ + p@ source-byte, 1 22 s+!
  repeat
;
: digit, 48 + source-byte, 32 source-byte, ;
: generate-source
  0 21 s! 0 26 s! 58 source-byte, 32 source-byte,
  0 22 s! begin 22 s@ 3 s@ 5 mf w@ < while
    3 s@ maddr 16 + 22 s@ + w@ source-byte, 1 22 s+!
  repeat 32 source-byte, 0 fragment,
  \ Finite product grammar:4 compositions x4 thresholds, lexicographic order.
  \ The source structure is constructed here, not selected as a whole program.
  5 s@ 1- 4 mod 1+ 23 s!
  5 s@ 1- 4 / dup 1 = swap 3 = or if
    1 fragment, 23 s@ digit, 2 fragment,
  then
  5 s@ 1- 4 / 0= if 23 s@ else 4 s@ 17 ef w@ then digit, 3 fragment,
  5 s@ 1- 4 / 2 = if 1 fragment, 23 s@ digit, 2 fragment, then
  5 s@ 1- 4 / 3 = if 4 fragment, then
  5 fragment,
  5 s@ 1- 4 / dup 1 = swap 2 = or if 4 fragment, then
  6 fragment,
  ." GENERATED " 2 s@ . 5 s@ . 3 s@ . 21 s@ . cr
  0 22 s! begin 22 s@ 21 s@ < while 512 22 s@ + p@ emit 1 22 s+! repeat cr
;
: generated-store
  0 22 s! begin 22 s@ 21 s@ < while
    512 22 s@ + p@ 3 s@ maddr 64 + 22 s@ + w! 1 22 s+!
  repeat
  21 s@ 3 s@ 6 mf w! 3 s@ 7 mf dup w@ 1+ swap w!
  ." SOURCE-STORED " 3 s@ . 21 s@ . cr
;
: keep-source
  21 s@ 39 s! 0 22 s! begin 22 s@ 21 s@ < while
    512 22 s@ + p@ 1024 22 s@ + p! 1 22 s+!
  repeat
;
: recall-source
  39 s@ 21 s! 0 22 s! begin 22 s@ 21 s@ < while
    1024 22 s@ + p@ 512 22 s@ + p! 1 22 s+!
  repeat
;
: trial-enter
  0 2 context-copy 3 0 context-copy
  ." WORLD 1 " 2 s@ . 5 s@ . cr
;
: trial-leave
  0 3 context-copy 2 0 context-copy
  ." WORLD 0 " 2 s@ . cr
;
: trial-record
  \ Bounded native result history survives opaque images. Sources for the
  \ current winner stay separately retained; older source may be unavailable.
  45 s@ 32 mod 32 * 1536 + 46 s!
  2 s@ 46 s@ p! 5 s@ 46 s@ 1+ p!
  10 s@ 46 s@ 2 + p! 8 s@ 46 s@ 3 + p!
  30 s@ 46 s@ 4 + p! 31 s@ 46 s@ 5 + p!
  35 s@ 46 s@ 6 + p! world-used @ 46 s@ 7 + p!
  33 s@ 46 s@ 8 + p! 34 s@ 46 s@ 9 + p!
  11 s@ 46 s@ 10 + p! 13 s@ 46 s@ 11 + p!
  1 s@ 46 s@ 12 + p!
  45 s@ 65535 < if 1 45 s+! then
;
: trial-create
  0 2 context-copy 1 0 context-copy
  ." WORLD 1 " 2 s@ . 5 s@ . cr
  0 26 s! 0 8 s!
  5 s@ if
    1 s@ 3 = if recall-source else 63 s@ 0= if generate-source then then
    generated-store 3 s@ module-compile
    ws-error @ if 1 26 s! then
  then
  trial-leave
;
: trial-score
  0 31 s! 0 33 s! 0 34 s! 0 22 s!
  begin 22 s@ 16 < while
    22 s@ 0 pf w@ 5 = if 1 31 s! then
    22 s@ 0 jf w@ if 1 33 s+! then
    22 s@ 6 ef w@ 34 s+!
    1 22 s+!
  repeat
  industry-account
  total-raw @ total-panels @ world-used @ + 2 * + world-supply @ = 0= if 1 31 s! then
  29 s@ 13 ef w@ dup 35 s! 9 s@ > 0= if 1 31 s! then
  4 s@ 231 pf w@ 62 s@ > 0= if 1 31 s! then
  ptick @ 4 s@ 232 pf w@ - 4 > if 1 31 s! then
  world-used @ 32 < total-raw @ 16384 < and 0= if 1 31 s! then
  31 s@ 26 s@ or if 0 30 s! else
    16384 35 s@ 512 * + world-used @ 128 * + total-raw @ +
    33 s@ 4 * - 34 s@ - 30 s!
  then
  ." TRIAL-RESULT " 2 s@ . 5 s@ . 10 s@ . 8 s@ .
  30 s@ . 31 s@ . 35 s@ . world-used @ . 33 s@ . 34 s@ . cr
  trial-record
;
: search-fresh?
  3 s@ valid-module if
    3 s@ 3 mf w@ serial-of 11 s@ =
    3 s@ 7 mf w@ 28 s@ = and world-epoch @ 13 s@ = and
    29 s@ 13 ef w@ 29 s@ 20 ef w@ < and
    3 s@ 10 mf w@ 0= and
  else 0 then
  23 s! 0 22 s! begin 22 s@ ws-nm @ < while
    22 s@ 3 mf w@ serial-of 80 22 s@ + s@ = 0= if 0 23 s! then
    1 22 s+!
  repeat 23 s@
;
: search-publish
  57 s@ if 57 s@ 7 s! 0 57 s! then
  61 s@ if 7 17 s! else 16 s@ 0= if 2 17 s! else
    search-fresh? if
      3 s@ module-pin 27 s!
      27 s@ 0= if 4 17 s! else
      recall-source generated-store 3 s@ module-compile
      ws-error @ if 4 17 s! 27 s@ version-release drop 0 27 s! else
        1 17 s! 1 19 s+! 1 36 s! ptick @ 37 s!
        29 s@ 13 ef w@ 38 s!
        3 s@ 3 mf w@ serial-of 44 s!
      then then
    else 3 17 s! then
  then then
  17 s@ 1 = 0= if 1 20 s+! then
  ." SEARCH-DECISION " 2 s@ . 17 s@ . 16 s@ . 14 s@ . 15 s@ . ptick @ . cr
  0 1 s!
  ptick @ 8 + 52 s!
  \ Reclaim all trial/checkpoint object ownership at fixed physical capacity.
  \ No branch handles are exposed after this point. No live state is imported.
  1 context-zero 2 context-zero 3 context-zero
;
: start-validation
  \ Fresh native checkpoint; a road closure/reopening is withheld from search.
  2 1 s! 0 5 s! 7 s@ 57 s! 7 s@ 16 min 7 s!
  ptick @ 10 s! 29 s@ 13 ef w@ 9 s! world-epoch @ 13 s!
  4 s@ 231 pf w@ 62 s!
  ." VALIDATION-BEGIN " 2 s@ . 10 s@ . 7 s@ . cr
  0 1 context-copy trial-create
;
: search-finish
  16 s@ search-fresh? and if start-validation else search-publish then
;
: search-start
  \ (factory-slot budget horizon --); privileged checked input.
  wc ! wb ! wa !
  1 s@ 36 s@ or if ." SEARCH-REFUSED 1" cr exit then
  wa @ 16 < wb @ 0 > and wb @ 17 < and
  wc @ 0 > and wc @ 65 < and 0= if ." SEARCH-REFUSED 2" cr exit then
  world-supply @ 16384 < 0= if ." SEARCH-REFUSED 8" cr exit then
  wa @ 1 ef w@ 2 = 0= if ." SEARCH-REFUSED 3" cr exit then
  wa @ 10 ef w@ entity-find dup 0= if drop ." SEARCH-REFUSED 4" cr exit then
  1- 29 s! 29 s@ 13 ef w@ 9 s!
  wa @ 4 s! wb @ 6 s! wc @ 7 s!
  4 s@ 2 pf w@ 3 s!
  3 s@ valid-module 0= if ." SEARCH-REFUSED 5" cr exit then
  3 s@ 10 mf w@ if ." SEARCH-REFUSED 6" cr exit then
  2 s@ 65535 = if ." SEARCH-REFUSED 7" cr exit then
  1 2 s+! 1 1 s! 0 5 s! 0 16 s! 0 17 s! 0 18 s!
  0 57 s! 0 59 s! 0 60 s! 0 61 s!
  0 63 s!
  ptick @ 10 s! 3 s@ 3 mf w@ serial-of 11 s!
  3 s@ 7 mf w@ 28 s! world-epoch @ dup 12 s! 13 s!
  4 s@ 231 pf w@ 62 s!
  0 22 s! begin 22 s@ ws-nm @ < while
    22 s@ 3 mf w@ serial-of 80 22 s@ + s! 1 22 s+!
  repeat
  ." SEARCH-BEGIN " 2 s@ . 3 s@ . 4 s@ . 29 s@ .
  10 s@ . 11 s@ . 6 s@ . 7 s@ . cr
  0 1 context-copy trial-create
;
: search-custom
  \ (source-length factory horizon --) then exactly source-length raw bytes.
  wc ! wb ! wn ! 0 ws-error !
  wn @ 513 < 0= if 4 wfail then read-bytes
  ws-error @ if report-error exit then
  1 s@ 36 s@ or if ." SEARCH-REFUSED 1" cr exit then
  wn @ 21 s! 0 22 s! begin 22 s@ 21 s@ < while
    ws-buffer 22 s@ + @ 512 22 s@ + p! 1 22 s+!
  repeat
  wb @ 1 wc @ search-start
  1 s@ if 1 63 s!
    ." SUBMITTED-CANDIDATE " 2 s@ . 21 s@ . cr
    0 22 s! begin 22 s@ 21 s@ < while 512 22 s@ + p@ emit 1 22 s+! repeat cr
  then
;
: search-step
  1 s@ 0= if exit then
  trial-enter
  0 40 s!
  begin 40 s@ 4 < 8 s@ 7 s@ < and 26 s@ 0= and while
    1 s@ 1 > world-roads @ 1 > and if
      8 s@ 4 = if 0 0 industry-open then
      8 s@ 7 = if 1 0 industry-open then
    then
    process-step 1 8 s+! 1 40 s+!
  repeat
  8 s@ 7 s@ >= 26 s@ or if
    trial-score
    1 s@ 2 = if
      30 s@ 59 s! trial-leave
      3 1 s! 16 s@ 5 s! trial-create exit
    then
    1 s@ 3 = if
      30 s@ 0 > 30 s@ 59 s@ >= and 60 s!
      60 s@ 0= 61 s!
      ." VALIDATION-RESULT " 2 s@ . 59 s@ . 30 s@ . 60 s@ . cr
      trial-leave search-publish exit
    then
    5 s@ 0= if 30 s@ dup 14 s! 15 s! else
      1 18 s+!
      30 s@ 15 s@ > if 30 s@ 15 s! 5 s@ 16 s! keep-source then
    then
    trial-leave
    18 s@ 6 s@ = if search-finish else
      5 s@ 0= if 63 s@ if 17 else 5 then else 5 s@ 16 mod 1+ then 5 s! trial-create
    then
  else trial-leave then
;
: observation-fault?
  0 64 s! 0 65 s!
  begin 64 s@ 16 < while
    64 s@ 0 pf w@ 5 = 64 s@ 2 pf w@ 3 s@ = and if 1 65 s! then
    1 64 s+!
  repeat 65 s@
