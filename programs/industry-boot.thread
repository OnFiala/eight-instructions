\ Initial raw input to BF; names, programs, inventory and map are boot data.
workspace-large
32 process-slice!
12 process-module depot.thread
110 0 source-write : depot.thread schema# 1 recv if swap 1 = if authorize else drop drop then else drop drop drop then dispatch ;
0 module-compile
19 process-module factory-west.thread
204 1 source-write : factory-west.thread schema# 1 recv if swap dup 3 = if drop accept else 1 = if authorize else drop drop then then else drop drop drop then batch# 3 dup 2 stock > if request else drop then work dispatch ;
1 module-compile
19 process-module factory-east.thread
204 2 source-write : factory-east.thread schema# 1 recv if swap dup 3 = if drop accept else 1 = if authorize else drop drop then then else drop drop drop then batch# 3 dup 2 stock > if request else drop then work dispatch ;
2 module-compile
10 process-module van.thread
122 3 source-write : van.thread schema# 1 1 priority recv if swap 2 = if claim else drop drop then else drop drop drop then 1 drive service ;
3 module-compile
14 process-module station.thread
106 4 source-write : station.thread schema# 1 recv if swap 3 = if accept else drop drop then else drop drop drop then build ;
4 module-compile
13 process-module signal.thread
70 5 source-write : signal.thread schema# 1 0 state@ 1 + dup 0 state! 8 mod 5 < signal ;
5 module-compile
